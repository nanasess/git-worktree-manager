#!/bin/bash
#
# worktree - Bulk git worktree management tool
#
# Manages worktree creation, listing, and deletion
# across multiple git repositories under a project root.
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# Load libraries
source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/detect.sh"
source "$SCRIPT_DIR/lib/deps.sh"
source "$SCRIPT_DIR/lib/cmd_create.sh"
source "$SCRIPT_DIR/lib/cmd_list.sh"
source "$SCRIPT_DIR/lib/cmd_cleanup.sh"
source "$SCRIPT_DIR/lib/cmd_install.sh"
source "$SCRIPT_DIR/lib/cmd_pull.sh"
source "$SCRIPT_DIR/lib/cmd_checkout.sh"

VERSION="0.1.0"

usage() {
    echo -e "${BOLD}worktree${NC} v${VERSION} - Bulk git worktree management tool"
    echo ""
    echo -e "${BOLD}USAGE:${NC}"
    echo "    worktree <COMMAND> [OPTIONS]"
    echo ""
    echo -e "${BOLD}COMMANDS:${NC}"
    echo "    create <task-name>    Create worktrees for a task"
    echo "    list                  List current worktrees"
    echo "    cleanup [task-name]   Remove worktrees"
    echo "    checkout [branch]     Checkout a branch on all repositories"
    echo "    pull                  Pull all repositories"
    echo "    install --skills      Install Claude Code skills"
    echo ""
    echo -e "${BOLD}OPTIONS:${NC}"
    echo "    -h, --help            Show help"
    echo "    -v, --version         Show version"
    echo ""
    echo "Per-command help: worktree <COMMAND> --help"
}

# Main
main() {
    if [ $# -eq 0 ]; then
        usage
        exit 1
    fi

    local command="$1"
    shift

    case "$command" in
        create)
            cmd_create "$@"
            ;;
        list|ls)
            cmd_list "$@"
            ;;
        cleanup|clean|rm)
            cmd_cleanup "$@"
            ;;
        checkout|co)
            cmd_checkout "$@"
            ;;
        pull)
            cmd_pull "$@"
            ;;
        install)
            cmd_install "$@"
            ;;
        -h|--help|help)
            usage
            exit 0
            ;;
        -v|--version|version)
            echo "worktree v${VERSION}"
            exit 0
            ;;
        *)
            log_error "Unknown command: $command"
            echo ""
            usage
            exit 1
            ;;
    esac
}

main "$@"
