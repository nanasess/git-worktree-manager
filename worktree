#!/usr/bin/env bash
#
# worktree - Bulk git worktree management tool
#
# Manages worktree creation, listing, and deletion
# across multiple git repositories under a project root.
#
# Requires Bash 4.0+ (associative arrays). macOS ships Bash 3.2, so the
# shebang resolves bash via PATH; install a newer bash (e.g. `brew install
# bash`) and make sure it precedes /bin in PATH.
#

set -euo pipefail

# Fail fast with a clear message on Bash < 4 (e.g. macOS system /bin/bash 3.2)
# instead of a cryptic `declare: -A: invalid option` deeper in the run.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    echo "Error: worktree requires Bash 4.0 or newer (found ${BASH_VERSION})." >&2
    echo "macOS ships Bash 3.2 as /bin/bash; install a newer bash and put it" >&2
    echo "ahead of /bin in PATH, e.g.: brew install bash" >&2
    exit 1
fi

# Resolve the real script directory, following symlinks (the recommended
# install is a symlink in ~/.local/bin). Uses plain `readlink` so it works on
# BSD/macOS too, where `readlink -f` is unavailable.
SOURCE="$0"
while [ -h "$SOURCE" ]; do
    dir="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$dir/$SOURCE" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Load libraries
source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/detect.sh"
source "$SCRIPT_DIR/lib/deps.sh"
source "$SCRIPT_DIR/lib/cmd_create.sh"
source "$SCRIPT_DIR/lib/cmd_list.sh"
source "$SCRIPT_DIR/lib/cmd_cleanup.sh"
source "$SCRIPT_DIR/lib/cmd_install.sh"
source "$SCRIPT_DIR/lib/cmd_pull.sh"
source "$SCRIPT_DIR/lib/cmd_checkout.sh"
source "$SCRIPT_DIR/lib/cmd_switch.sh"

VERSION="0.1.0"

usage() {
    echo -e "${BOLD}worktree${NC} v${VERSION} - Bulk git worktree management tool"
    echo ""
    echo -e "${BOLD}USAGE:${NC}"
    echo "    worktree <COMMAND> [OPTIONS]"
    echo ""
    echo -e "${BOLD}COMMANDS:${NC}"
    echo "    create <task-name>    Create worktrees for a task"
    echo "    list                  List current worktrees"
    echo "    cleanup [task-name]   Remove worktrees"
    echo "    checkout [branch|URL] Checkout a branch, or create a worktree from issue/PR URL"
    echo "    switch [name|-]       cd into a worktree (needs shell-init)"
    echo "    pull                  Pull all repositories"
    echo "    install --skills      Install Claude Code skills"
    echo "    shell-init            Print shell integration for 'switch'"
    echo ""
    echo -e "${BOLD}OPTIONS:${NC}"
    echo "    -h, --help            Show help"
    echo "    -v, --version         Show version"
    echo ""
    echo "Per-command help: worktree <COMMAND> --help"
}

# Main
main() {
    if [ $# -eq 0 ]; then
        usage
        exit 1
    fi

    local command="$1"
    shift

    case "$command" in
        create)
            cmd_create "$@"
            ;;
        list|ls)
            cmd_list "$@"
            ;;
        cleanup|clean|rm)
            cmd_cleanup "$@"
            ;;
        checkout|co)
            cmd_checkout "$@"
            ;;
        switch|sw)
            cmd_switch "$@"
            ;;
        shell-init)
            cmd_shell_init "$@"
            ;;
        pull)
            cmd_pull "$@"
            ;;
        install)
            cmd_install "$@"
            ;;
        -h|--help|help)
            usage
            exit 0
            ;;
        -v|--version|version)
            echo "worktree v${VERSION}"
            exit 0
            ;;
        *)
            log_error "Unknown command: $command"
            echo ""
            usage
            exit 1
            ;;
    esac
}

main "$@"
